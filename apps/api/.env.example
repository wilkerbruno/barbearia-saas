# Local (com `pnpm db:up`, ver infra/docker-compose.yml):
DATABASE_URL="mysql://barbearia:barbearia_dev@localhost:3306/barbearia_saas"

# Produção (MySQL do EasyPanel): use o HOSTNAME INTERNO do serviço de banco
# (algo como "barbearia-saas-mysql", visível no próprio EasyPanel), nunca o
# domínio público — assim o tráfego nunca sai da rede interna do EasyPanel.
# Veja docs/DEPLOY_EASYPANEL.md para o passo a passo completo.
# DATABASE_URL="mysql://app_barbearia:SENHA_FORTE_AQUI@barbearia-saas-mysql:3306/barbearia_saas"

# Gere um valor forte e único (nunca reaproveite entre ambientes):
# openssl rand -base64 48
JWT_SECRET="troque-isso-por-um-segredo-forte-em-producao"
JWT_EXPIRES_IN="7d"
PORT=3000

# Opcional: se definidos, o container cria (ou atualiza a senha de) esse
# usuário SAAS_ADMIN sozinho ao subir — é assim que você acessa o painel do
# dono da plataforma pela primeira vez sem precisar de SSH/console pra criar
# esse registro na mão. Defina só em produção (no EasyPanel), com uma senha
# forte; pode remover depois do primeiro login se preferir.
# SAAS_ADMIN_EMAIL="voce@suaempresa.com"
# SAAS_ADMIN_SENHA="uma-senha-forte-aqui"

# Mercado Pago — cobrança recorrente da mensalidade das barbearias assinantes
# do SaaS (ver AssinaturasService/MercadoPagoService). Pegue o Access Token em
# https://www.mercadopago.com.br/developers/panel > sua aplicação >
# Credenciais de produção (ou "de teste" pra testar com cartões de sandbox
# antes de ir ao ar). Sem isso definido, o botão "trocar de plano" no app da
# barbearia mostra um erro amigável em vez de travar o sistema.
MERCADOPAGO_ACCESS_TOKEN=""

# Chave secreta do webhook — NÃO é o Access Token. Pegue em: sua aplicação >
# Webhooks > Configurar notificações > "Assinatura secreta" (mostrar chave).
# Usada pra validar que uma notificação recebida em /webhooks/pagamento
# realmente veio do Mercado Pago. Opcional, mas fortemente recomendado em
# produção — sem isso o webhook processa qualquer POST sem checar a origem.
MERCADOPAGO_WEBHOOK_SECRET=""

# Pra onde o Mercado Pago manda o dono da barbearia de volta depois de
# autorizar a assinatura no checkout. Uma página simples de "pagamento
# confirmado" do seu painel web (ver apps/admin-web/src/app/pagamento-confirmado) —
# em produção, use a URL pública do admin-web (ex: https://painel.suabarbearia.com/pagamento-confirmado).
MERCADOPAGO_BACK_URL="http://localhost:3001/pagamento-confirmado"
